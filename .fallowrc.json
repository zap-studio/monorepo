{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "apps/docs/vocs.config.ts",
    "packages/oxlint/src/anti-slop/**"
  ],
  "duplicates": {
    "ignore": ["**/*.test.ts"]
  },
  "dynamicallyLoaded": ["apps/docs/src/pages/**/*.mdx"],
  "workspaces": {
    "patterns": ["apps/*", "configs/*", "packages/*"]
  },
  "ignoreDependencies": [
    "@arethetypeswrong/core",
    "@e18e/eslint-plugin",
    "@oxlint/plugins",
    "@stylexjs/eslint-plugin",
    "@tanstack/eslint-plugin-query",
    "@tanstack/eslint-plugin-router",
    "@zap-studio/fetch",
    "@zap-studio/oxfmt",
    "@zap-studio/oxlint",
    "@zap-studio/permit",
    "@zap-studio/retry",
    "@zap-studio/validation",
    "@zap-studio/webhooks",
    "eslint-plugin-cypress",
    "eslint-plugin-github",
    "eslint-plugin-jest-dom",
    "eslint-plugin-playwright",
    "eslint-plugin-regexp",
    "eslint-plugin-solid",
    "eslint-plugin-sonarjs",
    "eslint-plugin-storybook",
    "eslint-plugin-tailwindcss",
    "eslint-plugin-testing-library",
    "oxlint-plugin-react-doctor",
    "publint",
    "react",
    "unplugin-unused",
    "waku"
  ],
  "ignoreExports": [
    {
      "file": "apps/docs/vocs.config.ts",
      "exports": ["default"]
    }
  ]
}
