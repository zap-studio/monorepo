{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "apps/docs/vocs.config.ts",
    "tools/oxlint/**"
  ],
  "duplicates": {
    "ignore": ["**/*.test.ts"]
  },
  "dynamicallyLoaded": ["apps/docs/src/pages/**/*.mdx"],
  "ignoreDependencies": [
    "@arethetypeswrong/core",
    "@e18e/eslint-plugin",
    "@oxlint/plugins",
    "@zap-studio/fetch",
    "@zap-studio/permit",
    "@zap-studio/retry",
    "@zap-studio/validation",
    "@zap-studio/webhooks",
    "eslint-plugin-playwright",
    "eslint-plugin-regexp",
    "eslint-plugin-sonarjs",
    "publint",
    "react",
    "unplugin-unused",
    "waku"
  ],
  "ignoreExports": [
    {
      "file": "apps/docs/vocs.config.ts",
      "exports": ["default"]
    }
  ]
}
