{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": ["oxfmt.config.ts", "oxlint.config.ts"],
  "duplicates": {
    "ignore": ["**/tests/**"]
  },
  "dynamicallyLoaded": ["apps/docs/src/pages/**/*.mdx"],
  "ignoreDependencies": [
    "@zap-studio/fetch",
    "@zap-studio/permit",
    "@zap-studio/retry",
    "@zap-studio/validation",
    "@zap-studio/webhooks"
  ],
  "ignoreExports": [
    {
      "file": "apps/docs/vocs.config.ts",
      "exports": ["default"]
    }
  ]
}
