{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "alexandretrotel",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "publish:check": "pnpm run check && pnpm run test && pnpm --filter './packages/*' run prepublishOnly",
    "fix": "pnpm exec ultracite fix --type-aware --type-check",
    "check": "pnpm exec ultracite check --type-aware --type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.32.1"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
}
