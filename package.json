{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "Alexandre Trotel",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ./tooling/tsdown/tsdown.config.ts",
    "dev": "pnpm --filter docs run dev",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "lint": "pnpm exec oxlint --type-aware --type-check",
    "lint:fix": "pnpm exec oxlint --fix --type-aware --type-check",
    "prepare": "lefthook install",
    "publish:check": "pnpm run build && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsrs --noEmit && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@varlock/bumpy": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zap-studio/oxfmt": "workspace:^",
    "@zap-studio/oxlint": "workspace:^",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
