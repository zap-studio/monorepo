{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "Alexandre Trotel",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ./tooling/tsdown/tsdown.config.ts",
    "dev": "pnpm --filter docs run dev",
    "fallow": "pnpm exec fallow --summary",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "lint": "pnpm exec oxlint --type-aware --type-check",
    "lint:fix": "pnpm exec oxlint --fix --type-aware --type-check",
    "prepare": "lefthook install",
    "publish:check": "pnpm run build && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "react-doctor": "pnpm exec react-doctor .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@varlock/bumpy": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zap-studio/oxfmt": "workspace:^",
    "@zap-studio/oxlint": "workspace:^",
    "eslint": "catalog:",
    "fallow": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react-doctor": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "engines": {
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
