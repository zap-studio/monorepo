{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "alexandretrotel",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs run dev",
    "build": "pnpm --filter './packages/*' run build",
    "publish:check": "pnpm run check && pnpm run test && pnpm --filter './packages/*' run prepublishOnly",
    "tegami": "node scripts/tegami.mts",
    "fix": "pnpm exec ultracite fix --type-aware --type-check",
    "check": "pnpm exec ultracite check --type-aware --type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tegami": "catalog:",
    "tsdown": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.32.1"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
