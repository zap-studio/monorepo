{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "Alexandre Trotel",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ./configs/tsdown/tsdown.config.ts",
    "fallow": "fallow --summary",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "lint": "pnpm exec oxlint --type-aware --type-check",
    "lint:fix": "pnpm exec oxlint --fix --type-aware --type-check",
    "prepare": "lefthook install",
    "publish:check": "pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm -r --if-present run prepublishOnly",
    "react-doctor": "react-doctor --scope full --verbose",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "for f in packages/*/tsconfig.json apps/*/tsconfig.json; do tsc --noEmit -p \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zap-studio/oxfmt": "workspace:*",
    "@zap-studio/oxlint": "workspace:*",
    "fallow": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react-doctor": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
