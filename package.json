{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "atrtde",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter docs run dev",
    "bench": "vitest bench --run",
    "bench:watch": "vitest bench --watch",
    "build": "pnpm --filter './packages/*' run build",
    "publish:check": "pnpm run check && pnpm run test && pnpm --filter './packages/*' run prepublishOnly",
    "tegami": "node scripts/tegami.mts",
    "fix": "pnpm exec ultracite fix --type-aware --type-check",
    "check": "pnpm exec ultracite check --type-aware --type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tegami": "catalog:",
    "tsdown": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.32.1"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
