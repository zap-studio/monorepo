{
  "name": "@zap-studio/monorepo",
  "private": true,
  "author": "Alexandre Trotel",
  "type": "module",
  "scripts": {
    "build": "tsdown --config ./tooling/tsdown/tsdown.config.ts",
    "dev": "pnpm --filter docs run dev",
    "fallow": "fallow --summary",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "lint": "pnpm exec oxlint --type-aware --type-check",
    "lint:fix": "pnpm exec oxlint --fix --type-aware --type-check",
    "prepare": "lefthook install",
    "publish:check": "pnpm run build && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsrs --noEmit && pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@varlock/bumpy": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@zap-studio/oxfmt": "workspace:^",
    "@zap-studio/oxlint": "workspace:^",
    "eslint": "catalog:",
    "fallow": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "unplugin-unused": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
