    "./jotai": "./dist/jotai.js",
    "./mobx": "./dist/mobx.js",
    "./motion": "./dist/motion.js",
    "./nextjs": "./dist/nextjs.js",
    "./nextjs-react-compiler": "./dist/nextjs-react-compiler.js",
    "./preact": "./dist/preact.js",
    "./r3f": "./dist/r3f.js",
    "./react": "./dist/react.js",
    "./react-compiler": "./dist/react-compiler.js",
    "./react-native": "./dist/react-native.js",
    "./react-router": "./dist/react-router.js",
    "./redux": "./dist/redux.js",
    "./remotion": "./dist/remotion.js",
    "./styled-components": "./dist/styled-components.js",
    "./tanstack": "./dist/tanstack.js",
    "./tanstack-react-compiler": "./dist/tanstack-react-compiler.js",
    "./testing": "./dist/testing.js",
    "./three": "./dist/three.js",
    "./valtio": "./dist/valtio.js",
    "./zustand": "./dist/zustand.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
