    "eslint-plugin-testing-library": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@zap-studio/typescript": "workspace:*",
    "oxlint": "catalog:",
