    "./mobx": "./dist/mobx.js",
    "./motion": "./dist/motion.js",
    "./nextjs": "./dist/nextjs.js",
    "./node": "./dist/node.js",
    "./playwright": "./dist/playwright.js",
    "./preact": "./dist/preact.js",
    "./r3f": "./dist/r3f.js",
    "./react": "./dist/react.js",
    "./react-a11y": "./dist/react-a11y.js",
    "./react-compiler": "./dist/react-compiler.js",
    "./react-doctor": "./dist/react-doctor.js",
    "./react-native": "./dist/react-native.js",
    "./react-perf": "./dist/react-perf.js",
    "./react-router": "./dist/react-router.js",
    "./redux": "./dist/redux.js",
    "./remotion": "./dist/remotion.js",
    "./solid": "./dist/solid.js",
    "./storybook": "./dist/storybook.js",
    "./styled-components": "./dist/styled-components.js",
    "./stylex": "./dist/stylex.js",
    "./tailwindcss": "./dist/tailwindcss.js",
    "./tanstack-query": "./dist/tanstack-query.js",
    "./tanstack-router": "./dist/tanstack-router.js",
    "./tanstack-start": "./dist/tanstack-start.js",
    "./testing-library": "./dist/testing-library.js",
    "./three": "./dist/three.js",
    "./valtio": "./dist/valtio.js",
    "./vitest": "./dist/vitest.js",
    "./zustand": "./dist/zustand.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run verify",
    "verify": "node scripts/verify-presets.mjs"
