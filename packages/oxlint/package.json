{
  "name": "@zap-studio/oxlint",
  "version": "1.0.0",
  "private": false,
  "description": "Zap Studio's oxlint preset: composable base, react, react-compiler, tanstack, and testing rule sets.",
  "keywords": [
    "config",
    "eslint",
    "lint",
    "oxlint",
    "preset",
    "react",
    "typescript"
  ],
  "homepage": "https://www.zapstudio.dev/packages/oxlint",
