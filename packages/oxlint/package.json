{
  "name": "@zap-studio/oxlint",
  "version": "2.2.1",
  "private": false,
  "description": "Zap Studio's oxlint preset: exclusive, single-owner rule sets — pick exactly the presets your project needs, nothing implied.",
  "keywords": [
    "config",
    "eslint",
    "lint",
    "oxlint",
    "preset",
    "react",
    "typescript"
  ],
  "homepage": "https://www.zapstudio.dev/packages/oxlint",
  "license": "MIT",
  "repository": {
    "type": "git",
