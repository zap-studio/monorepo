{
  "name": "@zap-studio/permit",
  "version": "2.0.0",
  "private": false,
  "description": "A type-safe, declarative, tree-shakeable authorization library for TypeScript with Standard Schema support.",
  "keywords": [
    "abac",
    "access-control",
    "arktype",
    "authorization",
    "permissions",
    "policy",
    "rbac",
    "standard-schema",
    "typescript",
    "valibot",
    "zod"
  ],
  "homepage": "https://www.zapstudio.dev/packages/permit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/permit"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./conditions": "./dist/conditions.js",
    "./errors": "./dist/errors.js",
    "./policy": "./dist/policy.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm -C ../.. run build"
  },
  "dependencies": {
    "@zap-studio/validation": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@zap-studio/logger": "workspace:*",
    "@zap-studio/typescript": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "catalog:",
    "@zap-studio/logger": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zap-studio/logger": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
