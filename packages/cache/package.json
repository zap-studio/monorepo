{
  "name": "@zap-studio/cache",
  "version": "1.0.0",
  "private": false,
  "description": "Zero-dependency in-memory key-value cache with pluggable eviction policies (LRU, LFU, FIFO), capacity limits, and optional TTL.",
  "keywords": [
    "cache",
    "eviction",
    "fifo",
    "lfu",
    "lru",
    "memoization",
    "ttl",
    "typescript"
  ],
  "homepage": "https://www.zapstudio.dev/packages/cache",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/cache"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cache": "./dist/cache.js",
    "./fifo": "./dist/fifo.js",
    "./lfu": "./dist/lfu.js",
    "./lru": "./dist/lru.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm -C ../.. run build"
  },
  "devDependencies": {
    "@zap-studio/typescript": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
