    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@zap-studio/store": "^1.0.0",
    "react": ">=18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
