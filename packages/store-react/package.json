    "react",
    "react-hooks",
    "state",
    "state-management",
    "store",
    "typescript"
  ],
  "homepage": "https://www.zapstudio.dev/store/react",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/store-react"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./use-store": "./dist/use-store.js",
    "./package.json": "./package.json"
