{
  "name": "@zap-studio/webhooks",
  "version": "2.1.0",
  "private": false,
  "description": "A lightweight, type-safe, tree-shakeable webhook router with Standard Schema validation, signature verification, and lifecycle hooks.",
  "keywords": [
    "arktype",
    "lifecycle hooks",
    "payload validation",
    "schema",
    "signature verification",
    "standard schema",
    "type-safe",
    "typescript",
    "valibot",
    "validation",
    "webhook router",
    "webhooks",
    "zod"
  ],
  "homepage": "https://www.zapstudio.dev/packages/webhooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/webhooks"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./errors": "./dist/errors.js",
    "./router": "./dist/router.js",
    "./types": "./dist/types.js",
    "./verify": "./dist/verify.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm -C ../.. run build"
  },
  "dependencies": {
    "@zap-studio/validation": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@zap-studio/logger": "workspace:*",
    "@zap-studio/typescript": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "catalog:",
    "@zap-studio/logger": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zap-studio/logger": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
