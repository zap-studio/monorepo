{
  "name": "@zap-studio/retry",
  "version": "0.3.1",
  "private": false,
  "description": "Composable retry policies for resilient async operations.",
  "keywords": [
    "backoff",
    "exponential backoff",
    "fetch",
    "http",
    "resilience",
    "retry",
    "typescript"
  ],
  "homepage": "https://www.zapstudio.dev/packages/retry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/retry"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./abort": "./dist/abort.js",
    "./errors": "./dist/errors.js",
    "./exponential-backoff": "./dist/exponential-backoff.js",
    "./fixed-delay": "./dist/fixed-delay.js",
    "./result-mode": "./dist/result-mode.js",
    "./sleep": "./dist/sleep.js",
    "./throw-mode": "./dist/throw-mode.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "prepublishOnly": "pnpm exec publint --strict && pnpm exec attw --profile esm-only --pack ."
  },
  "devDependencies": {
    "@zap-studio/typescript": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
