{
  "name": "@zap-studio/retry",
  "version": "2.0.0",
  "private": false,
  "description": "Composable, tree-shakeable retry policies for resilient async operations.",
  "keywords": [
    "backoff",
    "exponential backoff",
    "fetch",
    "http",
    "linear backoff",
    "resilience",
    "retry",
    "typescript"
  ],
  "homepage": "https://www.zapstudio.dev/packages/retry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/retry"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./base-policy": "./dist/base-policy.js",
    "./errors": "./dist/errors.js",
    "./exponential-backoff": "./dist/exponential-backoff.js",
    "./fixed-delay": "./dist/fixed-delay.js",
    "./jitter": "./dist/jitter.js",
    "./linear-backoff": "./dist/linear-backoff.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zap-studio/monads": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@zap-studio/logger": "workspace:*",
    "@zap-studio/typescript": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "catalog:",
    "@zap-studio/logger": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zap-studio/logger": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
