{
  "name": "@zap-studio/fetch",
  "version": "2.0.0",
  "private": false,
  "description": "A type-safe, tree-shakeable fetch wrapper for HTTP requests with runtime schema validation.",
  "keywords": [
    "api",
    "arktype",
    "error handling",
    "fetch",
    "http",
    "request",
    "response",
    "runtime validation",
    "schema",
    "standard schema",
    "type-safe",
    "typescript",
    "valibot",
    "validation",
    "zod"
  ],
  "homepage": "https://www.zapstudio.dev/packages/fetch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zap-studio/monorepo.git",
    "directory": "packages/fetch"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./errors": "./dist/errors.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zap-studio/monads": "workspace:*",
    "@zap-studio/validation": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@zap-studio/logger": "workspace:*",
    "@zap-studio/typescript": "workspace:*",
    "arktype": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "catalog:",
    "@zap-studio/logger": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zap-studio/logger": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
