{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zap-studio-docs",
  "compatibility_date": "2026-08-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "zapstudio.dev", "custom_domain": true },
    { "pattern": "www.zapstudio.dev", "custom_domain": true },
  ],
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
