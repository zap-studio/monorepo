---
import type { PageRecord } from "blume";

import { findPackage } from "../lib/packages.ts";

interface Props {
  page: PageRecord;
}

const { page } = Astro.props;

const siteUrl = "https://www.zapstudio.dev";
const repoUrl = "https://github.com/zap-studio/monorepo";

const pkg = findPackage(/^\/docs\/([^/]+)/u.exec(page.route)?.[1] ?? "");

const softwareLd = pkg && {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  applicationCategory: "DeveloperApplication",
  codeRepository: `${repoUrl}/tree/main/packages/${pkg.slug}`,
  description: pkg.description,
  downloadUrl: `https://www.npmjs.com/package/${pkg.name}`,
  license: `${repoUrl}/blob/main/LICENSE`,
  name: pkg.name,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  operatingSystem: "Cross-platform",
  softwareVersion: pkg.version,
  url: `${siteUrl}/docs/${pkg.slug}`,
};
---

{softwareLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareLd)} />}
